<?xml version="1.0"?>
<package format="3">
  <name>gpd_ros2</name>
  <version>0.1.0</version>
  <description>ROS 2 wrapper/node for GPD.</description>
  <maintainer email="you@example.com">You</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core ROS 2 -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>pcl_conversions</depend>

  <!-- Our interfaces -->
  <depend>gpd_ros2_interfaces</depend>

  <!-- Optional conversions from tf/eigen if needed later -->
  <depend>eigen_conversions</depend>

  <!-- Runtime for messages -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- System deps (OpenCV/PCL) are found via CMake; list as build export hints -->
  <build_export_depend>ament_cmake</build_export_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
